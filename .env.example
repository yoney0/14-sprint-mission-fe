# Browser/API origin. The custom server serves Next and Express on one origin.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=0

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/panda_market?schema=public

# Use independent, high-entropy values in every deployed environment.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
JWT_REFRESH_REUSE_GRACE_SECONDS=5
COOKIE_SECURE=false

# Google OAuth (optional until the Google login flow is used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3000

# Local upload policy. Use persistent storage in production.
UPLOAD_DIRECTORY=public/uploads
MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_FILES_PER_USER=60
UPLOAD_MAX_BYTES_PER_USER=314572800
UPLOAD_ORPHAN_TTL_SECONDS=86400
UPLOAD_SWEEP_INTERVAL_SECONDS=3600

# Development seed only
SEED_USER_EMAIL=demo@panda.local
SEED_USER_PASSWORD=PandaDemo123!
